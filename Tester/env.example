# Environment for ResortTester. Do not commit real values.
# HOTEL_TEST_SERVER is the TCP host used by the socket thread (port 1250).
# The database variables fill the connection the tester used to hard-code.

HOTEL_TEST_SERVER=
HOTEL_TEST_DB_HOST=
HOTEL_TEST_DB_NAME=
HOTEL_TEST_DB_USER=
HOTEL_TEST_DB_PASSWORD=
