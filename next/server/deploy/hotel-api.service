[Unit]
Description=Hotel API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hotel-api
Group=hotel-api
EnvironmentFile=-/etc/hotel-api/hotel-api.env
# hotel-api.ini beside this binary wins. Otherwise the process reads
# /etc/hotel-api/hotel-api.ini. A non-empty EnvironmentFile value overrides
# the matching ini key. An empty value does not.
ExecStart=/usr/local/bin/hotel-api
Restart=on-failure
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
