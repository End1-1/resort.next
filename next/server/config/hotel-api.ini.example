# Боевой файл называется hotel-api.ini. Этот .example процесс не читает.
# Куда класть hotel-api.ini, формат ключей и ошибки: next/docs/server-config.md
#
# Поиск, если HOTEL_CONFIG пуст:
#   1. hotel-api.ini рядом с exe (не текущий каталог; служба Windows стартует из System32)
#   2. /etc/hotel-api/hotel-api.ini только на Linux
# Непустой HOTEL_CONFIG заменяет оба шага.
# HOTEL_LISTEN, HOTEL_DSN, HOTEL_WS_LISTEN перекрывают ключ только если не пустые.
# Пустая переменная ключ из файла не стирает.
# hotel-api.ini в git не коммитить.

# HTTP. Числовой IP и порт, либо один порт (тогда 127.0.0.1).
# Нет ключа — 127.0.0.1:8080. localhost не принимается.
# Годится: 127.0.0.1:8080, 0.0.0.0:8080, 8080
# Не годится: localhost:8080, 127.0.0.1, порт 0
listen=127.0.0.1:8080

# MariaDB. Пусто — базу не открывать, /health останется db.state=skipped.
# Формат: mysql://USER:PASSWORD@HOST:3306/DATABASE
# В логине и пароле @ пишите как %40, : как %3A.
# Пример: mysql://hotel_api:p%40ss%3Aword@127.0.0.1:3306/resort
# Без query и fragment: ?charset=... обрывает старт.
dsn=

# WebSocket /api/v1/ws. Пусто — сокет выключен.
# Те же правила адреса, что у listen. Порт другой, не тот же, что listen.
# Пример: 127.0.0.1:8081
ws_listen=
