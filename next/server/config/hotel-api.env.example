# Copy this file outside the git repository (for example /etc/hotel-api/hotel-api.env)
# and reference it from systemd EnvironmentFile=. hotel-api does not parse this file
# itself. Do not commit real passwords or this file once it has been filled in.

HOTEL_LISTEN=127.0.0.1:8080

# MariaDB. A non-empty value overrides the same key in hotel-api.ini.
# An empty value does not clear the ini. The password is literal: do not
# percent-encode @ : % # or ;.
# The database is on when HOST and SCHEMA are non-empty. USER is then required.
# PORT is optional (default 3306).
HOTEL_MYSQL_HOST=
HOTEL_MYSQL_PORT=
HOTEL_MYSQL_SCHEMA=
HOTEL_MYSQL_USER=
HOTEL_MYSQL_PASSWORD=

# Optional WebSocket listener for realtime hints. Unset means WebSocket stays off.
# HOTEL_WS_LISTEN=127.0.0.1:8081

# Optional path that replaces the default ini search. Ignored when empty.
# The default search is hotel-api.ini next to the executable, then
# /etc/hotel-api/hotel-api.ini on Linux.
# HOTEL_CONFIG=/etc/hotel-api/hotel-api.ini
#
# A non-empty HOTEL_LISTEN, HOTEL_WS_LISTEN, or HOTEL_MYSQL_* value overrides
# the same key in the ini. An empty value does not.
# A leftover HOTEL_DSN is used only when every mysql_* value above is empty,
# and startup then logs that dsn is deprecated. If any mysql_* value is set,
# HOTEL_DSN is ignored and startup logs that mysql_* overrides dsn.
