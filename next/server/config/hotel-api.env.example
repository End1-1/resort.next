# Copy this file outside the git repository (for example /etc/hotel-api/hotel-api.env)
# and reference it from systemd EnvironmentFile=. hotel-api does not parse this file
# itself. Do not commit real passwords, DSNs, or this file once it has been filled in.

HOTEL_LISTEN=127.0.0.1:8080

# mysql://USER:PASSWORD@HOST:3306/DATABASE
# Percent-encode reserved characters in USER and PASSWORD (%40 for @, %3A for :).
# Non-empty: this DSN is used. Empty: does not clear a dsn in hotel-api.ini.
# With no ini and an empty value, GET /health reports db.state=skipped.
HOTEL_DSN=

# Optional WebSocket listener for realtime hints. Unset means WebSocket stays off.
# HOTEL_WS_LISTEN=127.0.0.1:8081

# Optional path that replaces the default ini search. Ignored when empty.
# The default search is hotel-api.ini next to the executable, then
# /etc/hotel-api/hotel-api.ini on Linux.
# HOTEL_CONFIG=/etc/hotel-api/hotel-api.ini
#
# A non-empty HOTEL_LISTEN, HOTEL_DSN, or HOTEL_WS_LISTEN overrides the same
# key in the ini. An empty value does not, so HOTEL_DSN= above does not clear
# a dsn written in hotel-api.ini. Delete a line to leave the ini in charge.
